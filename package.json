{
  "name": "gta-vibe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GTA Vibe - an original first-person open-world game set in Meridian Bay, built with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4183 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.mts,.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
