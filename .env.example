# Copy this file to .env and fill values locally. Never commit .env.

# ElevenLabs speech, music, sound effects, and MCP-backed audio tools.
ELEVENLABS_API_KEY=

# OpenAI API; GPT Image 2 uses the model id gpt-image-2.
OPENAI_API_KEY=

# Tripo CLI/API for 3D generation, texturing, rigging, and animation.
TRIPO_API_KEY=

# Optional when TesterArmy is not already authenticated through its local config.
TESTERARMY_API_KEY=

# Non-secret durable QA identifiers, populated after the QA project exists.
TESTERARMY_PROJECT_ID=
TESTERARMY_SMOKE_TEST_ID=

# Local application URL used by the reusable TesterArmy smoke test.
APP_URL=http://127.0.0.1:4173
